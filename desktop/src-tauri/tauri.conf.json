{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDL Manager",
  "version": "1.1.0",
  "identifier": "com.ddlmanager.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DDL Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NzFBRUM0NTUxNkYzN0EKUldSNjh4WlZ4SzV4aFhnMmcrcGJXYU95S3pyM1g0TER5NFF0VTR6b1Q2Ri9sMUVHU3BCdnhiRjcK",
      "endpoints": [
        "https://github.com/jaasoncao2007/DDL-Manager/releases/latest/download/latest.json"
      ]
    }
  }
}
